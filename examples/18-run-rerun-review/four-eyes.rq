# The review rule, complete: four eyes, people only. Anchored by its hash before anyone reviews.
#
# What is checked comes from check.sh, in the graph <urn:kton:check>: the review scope R, the foton and
# the hash of this file. Every claim is read through its own nanopublication: its signer from ITS
# provenance graph (verified against the trusted keys), its scope from ITS pubinfo graph. A triple that
# merely appears in some other claim's assertion counts for nothing.
#
# - The owner is the verified signer of the genesis of P, the scope R names as its parent.
# - The rule holds only if the owner anchored R in P (review-initialised -> the rule claim) and the rule
#   claim, signed by the owner in R, names the hash of THIS file.
# - Who is a person or a software agent: only the owner's declarations in P.
# - An approval counts only from R, with a verified signature, by a signer the owner declared a person
#   and not a software agent, who is not a verified signer of the foton, and who also approved, in R,
#   every description and rationale said about the foton (by claim id: a changed text is a new claim).
# Four eyes = the rule holds, at least two counted approvals and no reject.
PREFIX nk:   <https://kton.dev/v/>
PREFIX lab:  <https://kton.dev/v/lab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX np:   <http://www.nanopub.org/nschema#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX ep:   <https://w3id.org/ep-plan#>
SELECT ?foton ?ruleAnchored
       (COUNT(DISTINCT ?counted) AS ?approvalsByPeople)
       (COUNT(DISTINCT ?rejecter) AS ?rejects)
       (COUNT(DISTINCT ?text) AS ?textsOnFoton)
       (GROUP_CONCAT(DISTINCT ?note; separator=", ") AS ?reviewers)
       (IF(?ruleAnchored = "yes" && COUNT(DISTINCT ?counted) >= 2 && COUNT(DISTINCT ?rejecter) = 0, "yes", "no") AS ?fourEyesPeopleOnly)
WHERE {
  GRAPH <urn:kton:check> { ?chk nk:reviewScope ?R ; nk:foton ?foton ; nk:ruleFile ?ruleFile }
  ?foton nk:signerVerified true .

  # R's genesis names its parent P; the owner is the verified signer of P's genesis
  GRAPH ?gR_h { ?gR np:hasAssertion ?gR_a ; np:hasPublicationInfo ?gR_i }
  FILTER(STR(?gR_h) = CONCAT(STR(?gR), "#Head") && STR(?gR_a) = CONCAT(STR(?gR), "#assertion") && STR(?gR_i) = CONCAT(STR(?gR), "#pubinfo"))
  GRAPH ?gR_i { ?gR nk:scope ?R ; nk:genesis true }
  GRAPH ?gR_a { ?scopeR nk:parent ?P }
  GRAPH ?gP_h { ?gP np:hasAssertion ?gP_a ; np:hasProvenance ?gP_p ; np:hasPublicationInfo ?gP_i }
  FILTER(STR(?gP_h) = CONCAT(STR(?gP), "#Head") && STR(?gP_a) = CONCAT(STR(?gP), "#assertion") && STR(?gP_p) = CONCAT(STR(?gP), "#provenance") && STR(?gP_i) = CONCAT(STR(?gP), "#pubinfo"))
  GRAPH ?gP_i { ?gP nk:scope ?P ; nk:genesis true }
  GRAPH ?gP_p { ?gP_a prov:wasAttributedTo ?owner ; nk:signerVerified true }

  # the rule holds: anchored by the owner in P, the rule claim by the owner in R names this file's hash
  BIND(IF(EXISTS {
    GRAPH ?an_h { ?an np:hasAssertion ?an_a ; np:hasProvenance ?an_p ; np:hasPublicationInfo ?an_i }
    FILTER(STR(?an_h) = CONCAT(STR(?an), "#Head") && STR(?an_a) = CONCAT(STR(?an), "#assertion") && STR(?an_p) = CONCAT(STR(?an), "#provenance") && STR(?an_i) = CONCAT(STR(?an), "#pubinfo"))
    GRAPH ?an_i { ?an nk:scope ?P }
    GRAPH ?an_p { ?an_a prov:wasAttributedTo ?owner ; nk:signerVerified true }
    GRAPH ?an_a { ?R nk:review-initialised ?an_o . ?an_o lab:hash ?ruleClaim }
    GRAPH ?ru_h { ?ru np:hasAssertion ?ru_a ; np:hasProvenance ?ru_p ; np:hasPublicationInfo ?ru_i }
    FILTER(STR(?ru_h) = CONCAT(STR(?ru), "#Head") && STR(?ru_a) = CONCAT(STR(?ru), "#assertion") && STR(?ru_p) = CONCAT(STR(?ru), "#provenance") && STR(?ru_i) = CONCAT(STR(?ru), "#pubinfo"))
    GRAPH ?ru_i { ?ru nk:scope ?R ; prov:wasDerivedFrom ?ruleClaim }
    GRAPH ?ru_p { ?ru_a prov:wasAttributedTo ?owner ; nk:signerVerified true }
    GRAPH ?ru_a { ?R nk:review-initialised ?ru_o . ?ru_o lab:hash ?ruleFile }
  }, "yes", "no") AS ?ruleAnchored)

  # the verdicts on the foton, from R only
  GRAPH ?v_h { ?v np:hasAssertion ?v_a ; np:hasProvenance ?v_p ; np:hasPublicationInfo ?v_i }
  FILTER(STR(?v_h) = CONCAT(STR(?v), "#Head") && STR(?v_a) = CONCAT(STR(?v), "#assertion") && STR(?v_p) = CONCAT(STR(?v), "#provenance") && STR(?v_i) = CONCAT(STR(?v), "#pubinfo"))
  GRAPH ?v_i { ?v nk:scope ?R }
  GRAPH ?v_p { ?v_a prov:wasAttributedTo ?who ; nk:signerVerified true }
  GRAPH ?v_a { ?foton nk:reviewed ?v_o . ?v_o lab:value ?verdict }

  # the texts said about the foton: verified description and rationale claims, by their claim id
  OPTIONAL {
    GRAPH ?t_h { ?t np:hasAssertion ?t_a ; np:hasProvenance ?t_p ; np:hasPublicationInfo ?t_i }
    FILTER(STR(?t_h) = CONCAT(STR(?t), "#Head") && STR(?t_a) = CONCAT(STR(?t), "#assertion") && STR(?t_p) = CONCAT(STR(?t), "#provenance") && STR(?t_i) = CONCAT(STR(?t), "#pubinfo"))
    GRAPH ?t_p { ?t_a nk:signerVerified true }
    GRAPH ?t_i { ?t prov:wasDerivedFrom ?text }
    GRAPH ?t_a { ?foton ?t_pred ?t_x } FILTER(?t_pred IN (dct:description, ep:hasRationale))
  }
  # a text the signer did not approve, in R, with the same verdict
  BIND(EXISTS {
    GRAPH ?u_h { ?u np:hasAssertion ?u_a ; np:hasProvenance ?u_p ; np:hasPublicationInfo ?u_i }
    FILTER(STR(?u_h) = CONCAT(STR(?u), "#Head") && STR(?u_a) = CONCAT(STR(?u), "#assertion") && STR(?u_p) = CONCAT(STR(?u), "#provenance") && STR(?u_i) = CONCAT(STR(?u), "#pubinfo"))
    GRAPH ?u_p { ?u_a nk:signerVerified true }
    GRAPH ?u_i { ?u prov:wasDerivedFrom ?c }
    GRAPH ?u_a { ?foton ?u_pred ?u_x } FILTER(?u_pred IN (dct:description, ep:hasRationale))
    FILTER NOT EXISTS {
      GRAPH ?w_h { ?w np:hasAssertion ?w_a ; np:hasProvenance ?w_p ; np:hasPublicationInfo ?w_i }
      FILTER(STR(?w_h) = CONCAT(STR(?w), "#Head") && STR(?w_a) = CONCAT(STR(?w), "#assertion") && STR(?w_p) = CONCAT(STR(?w), "#provenance") && STR(?w_i) = CONCAT(STR(?w), "#pubinfo"))
      GRAPH ?w_i { ?w nk:scope ?R }
      GRAPH ?w_p { ?w_a prov:wasAttributedTo ?who ; nk:signerVerified true }
      GRAPH ?w_a { ?c nk:reviewed ?w_o . ?w_o lab:value ?w_v }
      FILTER(STR(?w_v) = STR(?verdict))
    }
  } AS ?uncovered)

  # who is who: the owner's declarations in P only
  BIND(EXISTS {
    GRAPH ?k_h { ?k np:hasAssertion ?k_a ; np:hasProvenance ?k_p ; np:hasPublicationInfo ?k_i }
    FILTER(STR(?k_h) = CONCAT(STR(?k), "#Head") && STR(?k_a) = CONCAT(STR(?k), "#assertion") && STR(?k_p) = CONCAT(STR(?k), "#provenance") && STR(?k_i) = CONCAT(STR(?k), "#pubinfo"))
    GRAPH ?k_i { ?k nk:scope ?P }
    GRAPH ?k_p { ?k_a prov:wasAttributedTo ?owner ; nk:signerVerified true }
    GRAPH ?k_a { ?who rdf:type ?k_o . ?k_o ?k_tp prov:Person }
  } AS ?person)
  BIND(EXISTS {
    GRAPH ?g_h { ?g np:hasAssertion ?g_a ; np:hasProvenance ?g_p ; np:hasPublicationInfo ?g_i }
    FILTER(STR(?g_h) = CONCAT(STR(?g), "#Head") && STR(?g_a) = CONCAT(STR(?g), "#assertion") && STR(?g_p) = CONCAT(STR(?g), "#provenance") && STR(?g_i) = CONCAT(STR(?g), "#pubinfo"))
    GRAPH ?g_i { ?g nk:scope ?P }
    GRAPH ?g_p { ?g_a prov:wasAttributedTo ?owner ; nk:signerVerified true }
    GRAPH ?g_a { ?who rdf:type ?g_o . ?g_o ?g_tp prov:SoftwareAgent }
  } AS ?agent)
  # the foton's verified signers (plankton export --rdf --trust-keys): whoever ran it, first or again
  BIND(EXISTS { ?foton prov:wasAttributedTo ?who } AS ?author)
  # a signer's name, not the "key:<keyid>" a record without a by gives it; no name shows as its IRI
  OPTIONAL { ?who rdfs:label ?label FILTER(!STRSTARTS(STR(?label), "key:")) }
  BIND(IF(?agent, "software agent", IF(?author, "signed the foton", IF(!?person, "not declared a person", IF(?uncovered, "did not cover the description and rationale", "")))) AS ?why)
  BIND(IF(STR(?verdict) = "approve" && ?why = "", ?who, ?unbound) AS ?counted)
  BIND(IF(STR(?verdict) = "reject", ?who, ?unbound) AS ?rejecter)
  BIND(CONCAT(COALESCE(?label, STR(?who)), " ", STR(?verdict), IF(?why = "", "", CONCAT(" (not counted: ", ?why, ")"))) AS ?note)
}
GROUP BY ?foton ?ruleAnchored
