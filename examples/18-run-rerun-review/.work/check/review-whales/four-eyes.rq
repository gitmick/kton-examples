# Four eyes, people only. Who approved this foton with a verified signature? Did they sign the foton
# themselves? And what did the review's owner (?owner, bound by the caller) declare them to be: a
# prov:Person or a prov:SoftwareAgent? Runs over the review's nanopublications + the plankton lineage.
PREFIX nk:   <https://kton.dev/v/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?who ?verdict ?isAuthor ?isPerson ?isAgent WHERE {
  ?a prov:wasAttributedTo ?who ;
     nk:signerVerified true .
  GRAPH ?a { ?foton nk:reviewed ?o . ?o ?p ?verdict . }
  BIND(EXISTS { ?foton nk:claimedSigner ?who } AS ?isAuthor)
  BIND(EXISTS { GRAPH ?d { ?who rdf:type ?t . ?t ?tp prov:Person } ?d prov:wasAttributedTo ?owner ; nk:signerVerified true } AS ?isPerson)
  BIND(EXISTS { GRAPH ?d { ?who rdf:type ?t . ?t ?tp prov:SoftwareAgent } ?d prov:wasAttributedTo ?owner ; nk:signerVerified true } AS ?isAgent)
}
