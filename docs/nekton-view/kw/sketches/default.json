  "_groupings": "Gruppierungen, deklariert wie alles andere. core/grouping.js kennt keine davon eingebaut ausser Art, Beteiligter und Signierer - was eine Domaene sonst gruppieren will, steht hier.",
  "groupings": [
    {
      "id": "herkunftswurzel",
      "label": "Herkunftswurzel",
      "by": "root",
      "path": "about*/builds-on*"
    },
    {
      "id": "term",
      "label": "Aussageart",
      "by": "term"
    }
  ],
  "facets": [
    "participant",
    "context",
    "verified",
    "signer"
  ],
  "_questions": "Benannte Fragen, geschrieben in derselben Algebra wie die fünf eingebauten (core/query.js): from / walk / where / as. Nichts ist nach id bevorzugt - 'Verfeinerungen' unten ist wörtlich dieselbe Form wie 'Auswirkung', nur eine andere Kante, und 'verortet, ungeprüft' zeigt, dass mehrere Bedingungen eine Frage ergeben.",
  "questions": [
    {
      "id": "unlocated",
      "label": "nicht verortet",
      "at": "graph",
      "gloss": "Läufe, zu denen niemand signiert hat, wo die Bytes liegen",
      "from": "fotons",
      "where": [
        {
          "lacks": {
            "pred": "downloadURL"
          }
        }
      ],
      "as": "list"
    },
    {
      "id": "qualified",
      "label": "qualifiziert",
      "at": "graph",
      "gloss": "Läufe mit einer Qualifizierungsaussage",
      "from": "fotons",
      "where": [
        {
          "has": {
            "pred": "qualifies-as"
          }
        }
      ],
      "as": "list"
    },
    {
      "id": "verfeinert",
      "label": "Verfeinerungen",
      "at": "node",
      "gloss": "worauf diese Aussage aufbaut - dieselbe Form wie Auswirkung, nur eine andere Kante",
      "from": "node",
      "walk": {
        "dir": "down",
        "edges": [
          "refines"
        ]
      },
      "as": "cone"
    },
    {
      "id": "ungeprueft-verortet",
      "label": "verortet, ungeprüft",
      "at": "graph",
      "gloss": "wo die Bytes liegen ist bekannt, freigegeben ist es nicht - zwei Bedingungen, eine Frage",
      "from": "fotons",
      "where": [
        {
          "has": {
            "pred": "downloadURL"
          }
        },
        {
          "lacks": {
            "pred": "reviewedBy",
            "value": "approve"
          }
        }
      ],
      "as": "list"
    }
  ],
  "_": "Was hier fehlt, ist Absicht: kton:edge/about steht für Claim-Kanten, deren voller Term nicht zurückgeholt werden konnte, weil der deklarierte claimId nicht zum Inhalt passt (plankton-flow: 15 von 15). Das ist ein Korpusfehler und wird sichtbar gelassen, nicht per Heuristik zusammengeführt.",
  "perspectives": {
    "full": {
      "label": "alles"
    },
