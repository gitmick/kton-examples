  "_groupings": "Gruppierungen, deklariert wie alles andere. core/grouping.js kennt keine davon eingebaut ausser Art, Beteiligter und Signierer - was eine Domaene sonst gruppieren will, steht hier.",
  "groupings": [
    {
      "id": "analyse",
      "label": "Analyse",
      "by": "root",
      "note": "aus welcher Analyse stammt das - der Wurzelknoten, von dem es abstammt. Genau das, was eine Richtung mit 250 Schritten lesbar macht.",
      "path": "about*/builds-on*"
    },
    {
      "id": "modellzweig",
      "label": "Modellzweig",
      "by": "root",
      "note": "aus welchem Zweig des Modellbaums",
      "path": "about*/parent-step*"
    },
    {
      "id": "term",
      "label": "Aussageart",
      "by": "term"
    }
  ],
  "facets": [
    "participant",
    "verified",
    "signer"
  ],
  "questions": [
    {
      "id": "modellbaum",
      "label": "entwickelt aus",
      "at": "node",
      "gloss": "die Kette von Läufen, aus denen dieser hervorgegangen ist - bis zu 95 tief",
      "from": "node",
      "walk": {
        "dir": "down",
        "edges": [
          "parent-step"
        ]
      },
      "as": "cone"
    },
    {
      "id": "abgeleitet",
      "label": "abgeleitet von",
      "at": "node",
      "gloss": "welche Datei aus welcher bearbeitet wurde",
      "from": "node",
      "walk": {
        "dir": "down",
        "edges": [
          "based-on"
        ]
      },
      "as": "cone"
    },
    {
      "id": "offene-kommentare",
      "label": "unbeantwortete Kommentare",
      "at": "graph",
      "gloss": "Prüfkommentare, auf die niemand geantwortet hat - wonach ein Auditor als Erstes sucht",
      "from": "claims",
      "where": [
        {
          "attr": {
            "name": "role",
            "in": [
              "review-comment"
            ]
          }
        },
        {
          "lacks": {
            "pred": "review-response"
          }
        }
      ],
      "as": "list"
    },
    {
      "id": "ohne-freigabe",
      "label": "ohne Freigabe",
      "at": "graph",
      "gloss": "Läufe, zu denen keine Zustimmung vorliegt",
      "from": "fotons",
      "where": [
        {
          "lacks": {
            "pred": "reviewedBy",
            "value": "approve"
          }
        }
      ],
      "as": "list"
    },
    {
      "id": "nicht-reproduziert",
      "label": "nicht reproduziert",
      "at": "graph",
      "gloss": "Läufe, die niemand unabhängig nachgerechnet hat",
      "from": "fotons",
      "where": [
        {
          "lacks": {
            "pred": "reproduces"
          }
        }
      ],
      "as": "list"
    }
  ],
